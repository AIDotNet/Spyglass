<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Spyglass.Sample"
        x:Class="Spyglass.Sample.MainWindow"
        x:DataType="local:MainViewModel"
        Width="560" Height="360" Title="Spyglass Sample">
  <StackPanel x:Name="Root" Margin="24" Spacing="12">
    <TextBlock x:Name="Heading" Text="{Binding Title}" FontSize="20" />
    <!-- Intentional typo, reflection binding: shows up in Spyglass › Bindings. -->
    <TextBlock x:Name="Broken" x:CompileBindings="False" Text="{Binding User.FullNmae}" />
    <TextBox x:Name="NameBox" PlaceholderText="Your name" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="SaveButton" Classes="primary" Content="Save" />
      <Button x:Name="CancelButton" Content="Cancel" />
    </StackPanel>
    <ComboBox x:Name="Choice" SelectedIndex="0" Width="180">
      <ComboBoxItem>One</ComboBoxItem>
      <ComboBoxItem>Two</ComboBoxItem>
    </ComboBox>
  </StackPanel>
</Window>
