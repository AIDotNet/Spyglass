<Project Sdk="Microsoft.NET.Sdk">
  <!-- A small app to debug with Spyglass. Deliberately contains a broken reflection binding (see MainWindow.axaml). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <ProjectReference Include="..\..\src\Spyglass.Agent.Advanced\Spyglass.Agent.Advanced.csproj" />
  </ItemGroup>
  <!-- XAML hot reload (Debug only): what `PackageReference Include="TKCode.Spyglass.HotReload"` gives an app outside this repo. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\..\src\Spyglass.Agent.HotReload\Spyglass.Agent.HotReload.csproj" />
    <ProjectReference Include="..\..\src\Spyglass.HotReload.Generators\Spyglass.HotReload.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="..\..\src\Spyglass.Agent.HotReload\buildTransitive\TKCode.Spyglass.HotReload.targets" Condition="'$(Configuration)' == 'Debug'" />
</Project>
