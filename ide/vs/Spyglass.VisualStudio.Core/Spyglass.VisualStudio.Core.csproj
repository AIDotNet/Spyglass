<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything the Visual Studio extension does that does not need Visual Studio: the hub connection (JSON-RPC over a
       WebSocket), auto-starting `spyglass serve`, reconnecting, and the editor-buffer → hub sync. Tested on any OS. -->
  <PropertyGroup>
    <!-- VisualStudio.Extensibility out-of-process extensions run on .NET 8. -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Spyglass.VisualStudio.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The official previewer's wire protocol (MIT, ships with Avalonia): message types and the BSON transport. The
         version matches the Avalonia the user's app uses only loosely; the protocol is stable across 11.x/12.x. -->
    <PackageReference Include="Avalonia.Remote.Protocol" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spyglass.VisualStudio.Core.Tests" />
  </ItemGroup>
</Project>
