<Project Sdk="Microsoft.NET.Sdk">
  <!-- VisualStudio.Extensibility out-of-process extension (design/hot-reload/README.md §8): runs on .NET 8 in its own
       process next to devenv.exe. All hub logic lives in Spyglass.VisualStudio.Core; this project only adapts the
       Visual Studio APIs (text view listeners, diagnostics, documents, settings, commands, tool window). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <RootNamespace>Spyglass.VisualStudio</RootNamespace>
    <!-- Lets the project compile (not package) on macOS/Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The preview window is plain WPF created in this (out-of-process) extension host: Remote UI cannot show a dynamic
         bitmap or report pane size and pointer positions. The window is built in code, there is no XAML to compile. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <!-- The .vsix is made by VsixUtil.exe (Windows only); elsewhere build the assembly and extension.json only. -->
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <CreateVsixContainer>false</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWPF adds these global usings; System.Windows.Shapes.Path would hide System.IO.Path everywhere. -->
    <Using Remove="System.Windows.Shapes" />
    <Using Remove="System.IO" />
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spyglass.VisualStudio.Core\Spyglass.VisualStudio.Core.csproj" />
  </ItemGroup>
  <!-- WPF's own dependencies that are part of the Microsoft.WindowsDesktop.App framework but also ship as NuGet packages.
       The build leaves them out (the framework "provides" them), but Visual Studio's extension host has WPF without
       them: opening the preview failed with "Could not load file or assembly 'System.Windows.Extensions, 8.0.0.0'".
       So they are shipped in the extension and HostAssemblies.cs loads them from there when the host cannot find them.
       ExcludeAssets="all": downloaded only, never referenced, so they cannot clash with the framework at build time. -->
  <ItemGroup>
    <WpfDependencyPackage Include="System.Windows.Extensions" Version="8.0.0" />
    <WpfDependencyPackage Include="System.Security.Permissions" Version="8.0.0" />
    <WpfDependencyPackage Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <WpfDependencyPackage Include="System.Diagnostics.EventLog" Version="8.0.2" />
    <WpfDependencyPackage Include="System.IO.Packaging" Version="8.0.1" />
    <WpfDependencyPackage Include="System.Security.Cryptography.Xml" Version="8.0.5" />
    <WpfDependencyPackage Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <WpfDependencyPackage Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <PackageReference Include="@(WpfDependencyPackage)" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="CopyWpfDependencies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_WpfDependencyDir Include="$(NuGetPackageRoot)$([System.String]::Copy('%(WpfDependencyPackage.Identity)').ToLowerInvariant())/%(WpfDependencyPackage.Version)" />
      <!-- The Windows implementation when the package has one (lib/ then holds a PlatformNotSupported stub). -->
      <_WpfDependencyDll Include="%(_WpfDependencyDir.Identity)/runtimes/win/lib/net8.0/*.dll" />
      <_WpfDependencyDll Include="%(_WpfDependencyDir.Identity)/lib/net8.0/*.dll" Condition="!Exists('%(_WpfDependencyDir.Identity)/runtimes/win/lib/net8.0')" />
      <ReferenceCopyLocalPaths Include="@(_WpfDependencyDll)" DestinationSubDirectory="" />
    </ItemGroup>
    <Error Condition="'@(_WpfDependencyDll)' == ''" Text="WPF dependency packages not found under $(NuGetPackageRoot)." />
  </Target>
  <ItemGroup>
    <!-- Remote UI: the XAML is sent to Visual Studio as text, never compiled here. -->
    <Page Remove="SpyglassStatusControl.xaml" />
    <EmbeddedResource Include="SpyglassStatusControl.xaml" LogicalName="$(RootNamespace).SpyglassStatusControl.xaml" />
  </ItemGroup>
</Project>
