{
  "$comment": "Part of the Avalonia XAML grammar (axaml.tmLanguage.json); see there.",
  "scopeName": "text.xml.axaml.attributes.injection",
  "injectionSelector": "L:text.xml.axaml meta.tag -string -comment, L:source.axaml meta.tag -string -comment",
  "patterns": [
    {
      "match": "(?:^|\\s+)(x)(:)(Class|ClassModifier|Name|Key|DataType|CompileBindings|FieldModifier|Shared|TypeArguments|Uid|FactoryMethod|Arguments)(?=\\s*=)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.namespace.xml"
        },
        "2": {
          "name": "entity.other.attribute-name.xml punctuation.separator.namespace.xml"
        },
        "3": {
          "name": "entity.other.attribute-name.localname.xml keyword.other.directive.axaml"
        }
      }
    },
    {
      "match": "(?:^|\\s+)(?:([-\\w]+)(:))?([A-Za-z_][\\w]*)(\\.)([A-Za-z_][\\w]*)(?=\\s*=)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.namespace.xml"
        },
        "2": {
          "name": "entity.other.attribute-name.xml punctuation.separator.namespace.xml"
        },
        "3": {
          "name": "entity.other.attribute-name.xml entity.name.type.attached.axaml"
        },
        "4": {
          "name": "punctuation.accessor.axaml"
        },
        "5": {
          "name": "entity.other.attribute-name.localname.xml entity.other.attribute-name.attached.axaml"
        }
      }
    }
  ]
}
