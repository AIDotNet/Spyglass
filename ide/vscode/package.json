{
  "name": "spyglass-avalonia",
  "displayName": "Spyglass for Avalonia",
  "description": "XAML hot reload and design-time preview for Avalonia: unsaved .axaml edits update the running app and a side-by-side preview as you type. Free and open source.",
  "version": "0.1.0",
  "publisher": "AIDotNet",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/AIDotNet/Spyglass" },
  "homepage": "https://github.com/AIDotNet/Spyglass/tree/main/ide/vscode",
  "bugs": { "url": "https://github.com/AIDotNet/Spyglass/issues" },
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Programming Languages", "Debuggers", "Other"],
  "keywords": ["avalonia", "xaml", "axaml", "hot reload", "devtools"],
  "main": "./out/src/extension.js",
  "activationEvents": ["workspaceContains:**/*.axaml", "onLanguage:axaml", "onLanguage:xml"],
  "contributes": {
    "languages": [
      { "id": "axaml", "aliases": ["Avalonia XAML", "axaml"], "extensions": [".axaml"], "configuration": "./language-configuration.json" }
    ],
    "grammars": [
      { "language": "axaml", "scopeName": "text.xml.axaml", "path": "./syntaxes/axaml.tmLanguage.json" },
      { "scopeName": "text.xml.axaml.tags.injection", "path": "./syntaxes/axaml.tags.injection.json", "injectTo": ["text.xml.axaml", "source.axaml"] },
      { "scopeName": "text.xml.axaml.attributes.injection", "path": "./syntaxes/axaml.attributes.injection.json", "injectTo": ["text.xml.axaml", "source.axaml"] },
      { "scopeName": "text.xml.axaml.values.injection", "path": "./syntaxes/axaml.values.injection.json", "injectTo": ["text.xml.axaml", "source.axaml"] }
    ],
    "commands": [
      { "command": "spyglass.openPreview", "title": "Open Preview to the Side", "category": "Spyglass", "icon": "$(open-preview)" },
      { "command": "spyglass.toggleHotReload", "title": "Toggle XAML Hot Reload", "category": "Spyglass" },
      { "command": "spyglass.openSpyglass", "title": "Open Spyglass", "category": "Spyglass" },
      { "command": "spyglass.reconnect", "title": "Reconnect", "category": "Spyglass" },
      { "command": "spyglass.runWithDotnetWatch", "title": "Run Project with dotnet watch", "category": "Spyglass" },
      { "command": "spyglass.showOutput", "title": "Show Output", "category": "Spyglass" },
      { "command": "spyglass.preview.restart", "title": "Restart Preview", "category": "Spyglass" },
      { "command": "spyglass.preview.build", "title": "Build Project for Preview", "category": "Spyglass" }
    ],
    "menus": {
      "editor/title": [
        { "command": "spyglass.openPreview", "when": "resourceExtname == .axaml || resourceExtname == .xaml", "group": "navigation@1" }
      ],
      "editor/context": [
        { "command": "spyglass.openPreview", "when": "resourceExtname == .axaml || resourceExtname == .xaml", "group": "navigation@9" }
      ]
    },
    "keybindings": [
      { "command": "spyglass.openPreview", "key": "ctrl+alt+shift+p", "mac": "cmd+alt+shift+p", "when": "resourceExtname == .axaml || resourceExtname == .xaml" }
    ],
    "configuration": {
      "title": "Spyglass",
      "properties": {
        "spyglass.port": { "type": "number", "default": 0, "description": "Port of the Spyglass hub. 0 = SPYGLASS_PORT or 29500." },
        "spyglass.command": { "type": "string", "default": "spyglass", "description": "The Spyglass command (dotnet tool `spyglass`), used to start `spyglass serve` when nothing listens on the port." },
        "spyglass.autoStart": { "type": "boolean", "default": true, "description": "Start `spyglass serve` in the background when no Spyglass is running." },
        "spyglass.hotReload.enabled": { "type": "boolean", "default": true, "description": "Send unsaved .axaml edits to running apps." },
        "spyglass.hotReload.delay": { "type": "number", "default": 300, "minimum": 0, "description": "Milliseconds without typing before an edit is sent. 0 = only on save." },
        "spyglass.preview.enabled": { "type": "boolean", "default": true, "description": "Enable the design-time preview (Spyglass: Open Preview)." },
        "spyglass.preview.autoOpen": { "type": "boolean", "default": false, "description": "Open the preview to the side automatically when an .axaml file is opened." },
        "spyglass.preview.zoom": { "type": "string", "default": "fit", "enum": ["fit", "25%", "50%", "75%", "100%", "125%", "150%", "200%", "300%", "400%"], "description": "Preview zoom. Ctrl+wheel in the preview also zooms." },
        "spyglass.preview.theme": { "type": "string", "default": "default", "enum": ["default", "light", "dark"], "description": "Theme variant of the previewed Window (RequestedThemeVariant); UserControl roots are previewed unchanged." },
        "spyglass.preview.delay": { "type": "number", "default": 300, "minimum": 0, "description": "Milliseconds without typing before the preview is updated from the unsaved editor buffer. 0 = only on save." }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:e2e": "npm run compile && node out/test/e2e/run.js",
    "package": "vsce package"
  },
  "dependencies": {
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/vscode": "1.95.0",
    "@types/ws": "8.18.1",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.6.0",
    "typescript": "5.9.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
