<Project Sdk="Microsoft.NET.Sdk">
  <!-- In-app agent: public Avalonia APIs only (design/research/03, spike S1).
       Avalonia 12 ships net8.0/net10.0 only, so the agent targets net8.0.
       TODO(D1): add a netstandard2.0 target built against Avalonia 11.2 for the Basic agent on 11.x. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Spyglass.Agent</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\Spyglass.Protocol\Spyglass.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spyglass.Agent.Advanced" />
    <InternalsVisibleTo Include="Spyglass.Agent.HotReload" />
    <InternalsVisibleTo Include="Spyglass.IntegrationTests" />
  </ItemGroup>
</Project>
