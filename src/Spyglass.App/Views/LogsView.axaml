<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="clr-namespace:Spyglass.App.ViewModels"
             x:Class="Spyglass.App.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <!-- Logs page: Avalonia's own log output, live (design/ux/01 Logs; D8 glass) -->
  <Border Classes="glass" Padding="16">
    <DockPanel>
      <!-- Title row -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,0,0,12">
        <TextBlock Text="Logs" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeLG}" VerticalAlignment="Center" />
        <arc:Badge Grid.Column="1" Margin="10,0,0,0" Tone="Neutral" Content="{Binding CountText}" IsVisible="{Binding HasEntries}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Margin="12,0,0,0" Text="{Binding RecordingText}" VerticalAlignment="Center"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        <arc:Button Grid.Column="3" Variant="Ghost" Command="{Binding ClearCommand}" ToolTip.Tip="Clear the list (the app keeps recording)"
                    AutomationProperties.Name="Clear logs">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="Trash2" Size="14" />
            <TextBlock Text="Clear" VerticalAlignment="Center" />
          </StackPanel>
        </arc:Button>
      </Grid>

      <!-- Filters: level (also sets what the agent records), area, text -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,10">
        <arc:SegmentedControl SelectedValue="{Binding MinLevel}" AutomationProperties.Name="Minimum level" VerticalAlignment="Center">
          <arc:SegmentedOption Value="Verbose" Label="Verbose" />
          <arc:SegmentedOption Value="Debug" Label="Debug" />
          <arc:SegmentedOption Value="Information" Label="Info" />
          <arc:SegmentedOption Value="Warning" Label="Warning" />
          <arc:SegmentedOption Value="Error" Label="Error" />
          <arc:SegmentedOption Value="Fatal" Label="Fatal" />
        </arc:SegmentedControl>
        <arc:Select Grid.Column="1" Margin="10,0,0,0" MinWidth="150" VerticalAlignment="Center"
                    AutomationProperties.Name="Area" ItemsSource="{Binding AreaOptions}" SelectedItem="{Binding Area, Mode=TwoWay}" />
        <arc:SearchField Grid.Column="2" Margin="10,0,0,0" Label="Filter logs" IsLabelVisible="False" VerticalAlignment="Center"
                         Placeholder="Filter by message, area or element" Text="{Binding SearchText}" />
      </Grid>

      <Panel>
        <arc:EmptyState IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Icon="{lucide:LucideGeometry Kind=ScrollText}" Title="{Binding EmptyTitle}"
                        Description="{Binding EmptyDescription}" />
        <Border Classes="glass chrome" IsVisible="{Binding HasEntries}" Padding="4">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Entries}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LogRowViewModel">
                  <Border Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                    <Grid ColumnDefinitions="88,78,96,*,Auto">
                      <TextBlock Text="{Binding Time}" VerticalAlignment="Top" Margin="0,4,0,0"
                                 FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                 Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                      <arc:Badge Grid.Column="1" Content="{Binding Level}" Tone="{Binding LevelTone}" Size="Small"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" />
                      <TextBlock Grid.Column="2" Text="{Binding Area}" VerticalAlignment="Top" Margin="0,4,8,0"
                                 FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,3,8,0"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                      <arc:Button Grid.Column="4" Variant="Ghost" IsVisible="{Binding HasSource}" IsEnabled="{Binding CanShow}"
                                  Command="{Binding ShowCommand}" ToolTip.Tip="{Binding ShowTip}" VerticalAlignment="Top"
                                  Padding="8,0" MinHeight="24" AutomationProperties.Name="Show element">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <lucide:LucideIcon Kind="LocateFixed" Size="14" />
                          <TextBlock Text="{Binding SourceText}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                     FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                        </StackPanel>
                      </arc:Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
