<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="clr-namespace:Spyglass.App.ViewModels"
             xmlns:loc="clr-namespace:Spyglass.App.Localization"
             x:Class="Spyglass.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <!-- Settings (wireframe W7): every change is applied and saved immediately. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeLG}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,14,0,2" />
    </Style>
    <Style Selector="TextBlock.label"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
      <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.keycap">
      <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
      <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
  </UserControl.Styles>

  <Border Classes="glass">
    <ScrollViewer x:Name="Scroller">
      <StackPanel x:Name="Page" MaxWidth="760" Margin="28,12,28,32" Spacing="10">
        <TextBlock Text="{loc:T Settings.Settings}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeXL}" Margin="2,10,0,0" />
        <TextBlock Classes="hint" Margin="2,0,0,0" Text="{Binding SaveStatus}" />
        <arc:Alert Tone="Danger" Title="{loc:T Settings.SettingsCouldNotBe}" IsOpen="True" IsVisible="{Binding SaveFailed}" />

        <!-- Appearance -->
        <TextBlock Classes="section" Text="{loc:T Settings.Appearance}" />
        <Border Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.Theme}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.SystemFollowsTheOperating}" />
              </StackPanel>
              <arc:SegmentedControl Grid.Column="1" SelectedValue="{Binding AppearanceKey}">
                <arc:SegmentedOption Value="System" Label="{loc:T Settings.System}" />
                <arc:SegmentedOption Value="Light" Label="{loc:T Settings.Light}" />
                <arc:SegmentedOption Value="Dark" Label="{loc:T Settings.Dark}" />
              </arc:SegmentedControl>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.AccentColour}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.SelectionFocusAndPrimary}" />
              </StackPanel>
              <arc:ChipGroup Grid.Column="1" ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent}" Label="{loc:T Settings.AccentColour}" MaxWidth="380" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.Animations}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.ReducedKeepsFadesBut}" />
              </StackPanel>
              <arc:SegmentedControl Grid.Column="1" SelectedValue="{Binding MotionKey}">
                <arc:SegmentedOption Value="Full" Label="{loc:T Settings.Full}" />
                <arc:SegmentedOption Value="Reduced" Label="{loc:T Settings.Reduced}" />
                <arc:SegmentedOption Value="Off" Label="{loc:T Settings.Off}" />
              </arc:SegmentedControl>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.Language}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.LanguageHint}" />
              </StackPanel>
              <arc:Select Grid.Column="1" Width="190" VerticalAlignment="Top" AutomationProperties.Name="{loc:T Settings.Language}"
                          ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding LanguageLabel, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Connection -->
        <TextBlock Classes="section" Text="{loc:T Settings.Connection}" />
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.ListeningPort}" />
                <TextBlock Classes="hint" Text="{Binding ListeningText}" />
              </StackPanel>
              <arc:NumberField Grid.Column="1" Width="150" Label="{loc:T Settings.ListeningPort}" IsLabelVisible="False" Minimum="1" Maximum="65535" Value="{Binding Port}" IsEnabled="{Binding !PortOverriddenByEnvironment}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding PortNote}" />
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Lan.AllowConnections}" />
                <TextBlock Classes="hint" Text="{loc:T Lan.AllowConnectionsHint}" />
              </StackPanel>
              <arc:Switch Grid.Column="1" IsChecked="{Binding Lan.AllowLan}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding Lan.RestartNote}" IsVisible="{Binding Lan.RestartPending}" />
            <arc:Alert Tone="Warning" IsOpen="True" IsVisible="{Binding Lan.AllowLan}" Title="{loc:T Lan.NotEncrypted}"
                       Content="{loc:T Lan.SettingsWarning}" />
            <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding Lan.IsActive}">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Lan.PairingCode}" />
                <TextBlock Classes="hint" Text="{loc:T Lan.PairingCodeHint}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Lan.Code}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeXL}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <arc:Button Variant="Secondary" Content="{loc:T Lan.Copy}" Command="{Binding Lan.CopyCodeCommand}" />
                <arc:Button Variant="Secondary" Content="{loc:T Lan.Regenerate}" Command="{Binding Lan.RegenerateCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Elements -->
        <TextBlock Classes="section" Text="{loc:T Settings.Elements}" />
        <Border Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.ShowTemplatePartsBy}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.IncludeTheInsidesOf}" />
              </StackPanel>
              <arc:Switch Grid.Column="1" IsChecked="{Binding ShowTemplateParts}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.KeepTheHighlightIn}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.OtherwiseTheBlueBox}" />
              </StackPanel>
              <arc:Switch Grid.Column="1" IsChecked="{Binding KeepHighlight}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Events -->
        <TextBlock Classes="section" Text="{loc:T Settings.Events}" />
        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="label" Text="{loc:T Settings.EventsKeptInThe}" />
              <TextBlock Classes="hint" Text="{loc:T Settings.WhenTheListIs}" />
            </StackPanel>
            <arc:NumberField Grid.Column="1" Width="150" Label="{loc:T Settings.EventsKept}" IsLabelVisible="False" Minimum="100" Maximum="100000" Value="{Binding EventBufferLimit}" />
          </Grid>
        </Border>

        <!-- Network -->
        <TextBlock Classes="section" Text="{loc:T Settings.Network}" />
        <Border Classes="card">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.StartRecordingWhenThe}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.RequestsAreOnlyIntercepted}" />
              </StackPanel>
              <arc:Switch Grid.Column="1" IsChecked="{Binding AutoRecordNetwork}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.CaptureRequestAndResponse}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.OffKeepsOnlyHeaders}" />
              </StackPanel>
              <arc:Switch Grid.Column="1" IsChecked="{Binding CaptureBodies}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding CaptureBodies}">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.BodySizeLimitKb}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.LargerBodiesAreCounted}" />
              </StackPanel>
              <arc:NumberField Grid.Column="1" Width="150" Label="{loc:T Settings.BodySizeLimit}" IsLabelVisible="False" Minimum="1" Maximum="10240" Value="{Binding BodyLimitKb}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.RecordWhereEachRequest}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.CapturesTheCallStack}" />
              </StackPanel>
              <arc:Switch Grid.Column="1" IsChecked="{Binding CaptureInitiator}" />
            </Grid>
            <TextBlock Classes="hint" Text="{loc:T Settings.AppliesTheNextTime}" />
          </StackPanel>
        </Border>

        <!-- Editor -->
        <TextBlock Classes="section" Text="{loc:T Settings.Editor}" />
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="{loc:T Settings.OpenXamlIn}" />
                <TextBlock Classes="hint" Text="{loc:T Settings.UsedByTheOpen}" />
              </StackPanel>
              <arc:SegmentedControl Grid.Column="1" SelectedValue="{Binding EditorKey}">
                <arc:SegmentedOption Value="VsCode" Label="VS Code" />
                <arc:SegmentedOption Value="Rider" Label="Rider" />
                <arc:SegmentedOption Value="VisualStudio" Label="Visual Studio" />
                <arc:SegmentedOption Value="System" Label="{loc:T Settings.System}" />
                <arc:SegmentedOption Value="Custom" Label="{loc:T Settings.Custom}" />
              </arc:SegmentedControl>
            </Grid>
            <arc:Input Label="{loc:T Settings.CustomCommand}" Placeholder="code --goto {file}:{line}:{column}" Text="{Binding CustomEditorCommand}" IsVisible="{Binding IsCustomEditor}"
                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <TextBlock Classes="hint" Text="{Binding EditorHint}" />
          </StackPanel>
        </Border>

        <!-- Shortcuts -->
        <TextBlock Classes="section" Text="{loc:T Settings.KeyboardShortcuts}" />
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="hint" VerticalAlignment="Center" Text="{loc:T Settings.ShortcutsHint}" />
              <arc:Button Grid.Column="1" Variant="Secondary" Content="{loc:T Settings.ResetAllShortcuts}" Command="{Binding ResetShortcutsCommand}" IsEnabled="{Binding HasCustomShortcuts}" Margin="12,0,0,0" />
            </Grid>
            <ItemsControl ItemsSource="{Binding ClientShortcuts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutItemViewModel">
                  <StackPanel Spacing="4" Margin="0,3">
                    <Grid ColumnDefinitions="90,*,230">
                      <TextBlock Text="{Binding Area}" Classes="hint" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <arc:ShortcutRecorder Grid.Column="2" Value="{Binding Value, Mode=TwoWay}" ResetValue="{Binding DefaultValue}"
                                            IsLabelVisible="False" Label="{Binding Title}" IsModifierRequired="False" IsReservedWarningEnabled="False" />
                    </Grid>
                    <Border IsVisible="{Binding HasConflict}" Background="{arc:ArcDesignTokenResource WarningSubtle}" CornerRadius="6" Padding="10,4">
                      <TextBlock Classes="hint" Text="{Binding ConflictText}" />
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" Margin="0,4" />
            <ItemsControl ItemsSource="{Binding Shortcuts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ShortcutRow">
                  <Grid ColumnDefinitions="110,150,*" Margin="0,3">
                    <TextBlock Text="{Binding Area}" Classes="hint" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="keycap" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Keys}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Action}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="hint" Text="{loc:T Settings.TheInAppShortcuts}" />
          </StackPanel>
        </Border>

        <!-- About -->
        <TextBlock Classes="section" Text="{loc:T Settings.About}" />
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Classes="label"><Run Text="Spyglass " /><Run Text="{Binding Version}" /></TextBlock>
                <TextBlock Classes="hint"><Run Text="{Binding ProtocolText}" /><Run Text="{loc:T Settings.SettingsFile}" /><Run Text="{Binding FilePath}" /></TextBlock>
              </StackPanel>
              <arc:Button Grid.Column="1" Variant="Secondary" Content="{loc:T Settings.ResetToDefaults}" Command="{Binding ResetCommand}" VerticalAlignment="Top" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
