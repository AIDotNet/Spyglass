<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
        xmlns:vm="clr-namespace:Spyglass.App.ViewModels"
             xmlns:loc="clr-namespace:Spyglass.App.Localization"
        xmlns:views="clr-namespace:Spyglass.App.Views"
        x:Class="Spyglass.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1320" Height="840" MinWidth="980" MinHeight="620"
        Title="Spyglass"
        TransparencyLevelHint="AcrylicBlur, Mica, Blur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
  <!-- Main frame W0 in the Liquid Glass style (D8): OS window blur + tinted layer + floating glass panels. -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ConnectionsViewModel"><views:ConnectionsView /></DataTemplate>
    <DataTemplate DataType="vm:ElementsViewModel"><views:ElementsView /></DataTemplate>
    <DataTemplate DataType="vm:BindingsViewModel"><views:BindingsView /></DataTemplate>
    <DataTemplate DataType="vm:NetworkViewModel"><views:NetworkView /></DataTemplate>
    <DataTemplate DataType="vm:LogsViewModel"><views:LogsView /></DataTemplate>
    <DataTemplate DataType="vm:EventsViewModel"><views:EventsView /></DataTemplate>
    <DataTemplate DataType="vm:ResourcesViewModel"><views:ResourcesView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:PerformanceViewModel"><views:PerformanceView /></DataTemplate>
    <DataTemplate DataType="vm:PlaceholderViewModel">
      <Border Classes="glass">
        <arc:EmptyState VerticalAlignment="Center" HorizontalAlignment="Center" Title="{Binding Title}" Description="{Binding Description}" />
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <!-- Debug self-screenshot only: a colourful "desktop" behind the glass (RenderTargetBitmap cannot capture the OS blur). -->
    <Border x:Name="SelfShotBackdrop" IsVisible="False" />
    <Panel Background="{DynamicResource Spy.WindowTint}">
      <DockPanel Margin="10,0,10,10">
        <!-- Title area: the OS draws the window buttons here; drag to move. -->
        <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="40" Background="Transparent">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                     FontSize="{arc:ArcDesignTokenResource TypeSM}" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                     Text="{Binding WindowTitle}" />
          <!-- Right side on macOS (window buttons are on the left); leave room for caption buttons elsewhere. -->
          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
            <arc:Button x:Name="PaletteButton" Variant="Ghost" Size="Small" arc:CommandPaletteDialog.Opens="{Binding #Palette}"
                        AutomationProperties.Name="{loc:T Palette.Label}">
              <lucide:LucideIcon Kind="Search" Width="16" Height="16" />
            </arc:Button>
            <arc:ThemeSwitcher x:Name="ThemeSwitch" IsIconOnly="True" Variant="Reveal" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- Status capsule -->
        <Border DockPanel.Dock="Bottom" Classes="glass chrome pill" Margin="0,10,0,0" Height="30" Padding="14,0" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding IsConnected}" />
            <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource TextMuted}" IsVisible="{Binding !IsConnected}" />
            <TextBlock VerticalAlignment="Center" FontSize="{arc:ArcDesignTokenResource TypeXS}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" Text="{Binding Status}" />
            <!-- Hot reload (design/hot-reload/README.md §1.3) -->
            <TextBlock VerticalAlignment="Center" FontSize="{arc:ArcDesignTokenResource TypeXS}" IsVisible="{Binding HasHotReload}"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" Text="·" />
            <TextBlock VerticalAlignment="Center" FontSize="{arc:ArcDesignTokenResource TypeXS}" MaxWidth="520" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding HasHotReload}" Text="{Binding HotReloadStatus}" ToolTip.Tip="{Binding HotReloadStatus}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" Classes.failed="{Binding HotReloadFailed}">
              <TextBlock.Styles>
                <Style Selector="TextBlock.failed"><Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" /></Style>
              </TextBlock.Styles>
            </TextBlock>
          </StackPanel>
        </Border>

        <!-- Floating navigation rail (Blocks Sidebar, D4) -->
        <Border DockPanel.Dock="Left" Classes="glass chrome" Margin="0,0,10,0" Padding="0,6">
          <arc:Sidebar x:Name="Nav" IsCollapsed="True" Background="Transparent" SelectedKey="{Binding Page, Mode=TwoWay}">
            <arc:SidebarSection>
              <arc:SidebarItem Key="elements" Label="{loc:T MainWindow.Elements}" Icon="{lucide:LucideGeometry Kind=ListTree}" />
              <arc:SidebarItem Key="events" Label="{loc:T MainWindow.Events}" Icon="{lucide:LucideGeometry Kind=Zap}" />
              <arc:SidebarItem Key="network" Label="{loc:T MainWindow.Network}" Icon="{lucide:LucideGeometry Kind=Network}" />
              <arc:SidebarItem Key="resources" Label="{loc:T MainWindow.Resources}" Icon="{lucide:LucideGeometry Kind=Package}" />
              <arc:SidebarItem Key="bindings" Label="{loc:T MainWindow.Bindings}" Icon="{lucide:LucideGeometry Kind=Link}" />
              <arc:SidebarItem Key="logs" Label="{loc:T MainWindow.Logs}" Icon="{lucide:LucideGeometry Kind=ScrollText}" />
              <arc:SidebarItem Key="performance" Label="{loc:T MainWindow.Performance}" Icon="{lucide:LucideGeometry Kind=Activity}" />
            </arc:SidebarSection>
            <arc:SidebarSection Header="{loc:T MainWindow.App}">
              <arc:SidebarItem Key="connections" Label="{loc:T MainWindow.Connections}" Icon="{lucide:LucideGeometry Kind=Plug}" />
              <arc:SidebarItem Key="settings" Label="{loc:T MainWindow.Settings}" Icon="{lucide:LucideGeometry Kind=Settings}" />
            </arc:SidebarSection>
          </arc:Sidebar>
        </Border>

        <!-- Pages (each lays out its own glass cards); cross-fade between pages -->
        <TransitioningContentControl Content="{Binding PageContent}">
          <TransitioningContentControl.PageTransition>
            <CrossFade Duration="0:0:0.18" />
          </TransitioningContentControl.PageTransition>
        </TransitioningContentControl>
      </DockPanel>
    </Panel>
    <!-- Command palette (W6): Cmd/Ctrl+I (configurable) or the search button; entries are rebuilt every time it opens. -->
    <arc:CommandPaletteDialog x:Name="Palette" PlaceholderText="{loc:T Palette.Placeholder}" Label="{loc:T Palette.Label}"
                              EmptyTitle="{loc:T Palette.EmptyTitle}" EmptyDescription="{loc:T Palette.EmptyDescription}"
                              CloseButtonLabel="{loc:T Palette.Close}" ResultsLabel="{loc:T Palette.Results}" />
  </Panel>
</Window>
