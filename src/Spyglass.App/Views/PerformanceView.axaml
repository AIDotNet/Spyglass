<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="clr-namespace:Spyglass.App.ViewModels"
             xmlns:loc="clr-namespace:Spyglass.App.Localization"
             x:Class="Spyglass.App.Views.PerformanceView"
             x:DataType="vm:PerformanceViewModel">
  <!-- Wireframe W5: live metrics while this page is open (the agent profiles only then). -->
  <Border Classes="glass" Padding="16">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,0,12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{loc:T Performance.Performance}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeLG}" VerticalAlignment="Center" />
          <TextBlock Classes="cardmeta" Text="{loc:T Performance.LiveWhileThisPage}" VerticalAlignment="Center" />
        </StackPanel>
        <arc:Button Grid.Column="1" Variant="Secondary" Size="Small" Content="{loc:T Performance.Reset}" Command="{Binding ResetCommand}" IsVisible="{Binding HasData}" />
      </Grid>
      <arc:Alert DockPanel.Dock="Top" Tone="Warning" Title="{Binding Status}" IsOpen="True" Margin="0,0,0,10" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <Panel>
        <arc:EmptyState IsVisible="{Binding Unsupported}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Icon="{lucide:LucideGeometry Kind=Activity}" Title="{loc:T Performance.MetricsAreNotAvailable}"
                        Description="{loc:T Performance.ThisAppSAgent}" />
        <arc:EmptyState IsVisible="{Binding Waiting}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Icon="{lucide:LucideGeometry Kind=Activity}" Title="{loc:T Performance.CollectingTheFirstSample}"
                        Description="{loc:T Performance.SamplesArriveOnceA}" />
        <ScrollViewer IsVisible="{Binding HasData}">
          <StackPanel Spacing="12" Margin="0,0,10,0">
            <!-- an app with nothing changing renders nothing: explain, instead of showing zeros -->
            <arc:Alert Tone="Info" IsOpen="True" IsVisible="{Binding IsIdle}" Title="{loc:T Performance.TheAppIsIdle}"
                       Content="{loc:T Performance.AvaloniaOnlyRendersAnd}" />
            <!-- metric cards -->
            <UniformGrid Columns="4">
              <Border Classes="card" Margin="0,0,10,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="cardmeta" Text="{loc:T Performance.FramesPerSecond}" />
                  <TextBlock Text="{Binding FpsText}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeLG}" />
                  <TextBlock Classes="cardmeta" Text="{Binding FpsContext}" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="0,0,10,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="cardmeta" Text="{loc:T Performance.Visuals}" />
                  <TextBlock Text="{Binding Visuals, StringFormat={}{0:N0}}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeLG}" />
                  <TextBlock Classes="cardmeta" Text="{loc:T Performance.InAllWindows}" />
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="0,0,10,0">
                <StackPanel Spacing="2">
                  <TextBlock Classes="cardmeta" Text="{loc:T Performance.LayoutPerPass}" />
                  <TextBlock Text="{Binding LayoutText}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeLG}" />
                  <TextBlock Classes="cardmeta" Text="{Binding LayoutContext}" />
                </StackPanel>
              </Border>
              <Border Classes="card" >
                <StackPanel Spacing="2">
                  <TextBlock Classes="cardmeta" Text="{loc:T Performance.RenderPerFrame}" />
                  <TextBlock Text="{Binding RenderText}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeLG}" />
                  <TextBlock Classes="cardmeta" Text="{Binding RenderContext}" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- findings (rule engine) -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="cardtitle" Text="{loc:T Performance.Findings}" VerticalAlignment="Center" />
                  <arc:Badge Tone="Warning" Content="{Binding Findings.Count}" IsVisible="{Binding HasFindings}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="cardmeta" Text="{loc:T Performance.NoIssuesDetectedNon}" IsVisible="{Binding NoFindings}" />
                <ItemsControl ItemsSource="{Binding Findings}" IsVisible="{Binding HasFindings}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FindingRow">
                      <Grid ColumnDefinitions="*,Auto">
                        <arc:Alert Tone="{Binding Tone}" Title="{Binding Message}" IsOpen="True" />
                        <arc:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Variant="Secondary" Size="Small"
                                    Content="{loc:T Performance.ShowElement}" Command="{Binding ShowCommand}" IsVisible="{Binding CanShow}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- charts -->
            <UniformGrid Columns="2">
              <Border Classes="card" Margin="0,0,6,0">
                <StackPanel Spacing="6">
                  <TextBlock Classes="cardtitle" Text="{loc:T Performance.FrameRateLast60}" />
                  <arc:LineChart Label="{loc:T Performance.FramesPerSecond}" PlotHeight="150" YMinimum="0" ShowLegend="False" Unit="fps" Curve="Linear"
                                 ItemsSource="{Binding History}" XBinding="{CompiledBinding T, DataType=vm:PerfPoint}" ShowXAxis="False">
                    <arc:LineChart.Series>
                      <arc:ChartSeries Key="fps" Name="FPS" ValueBinding="{CompiledBinding Fps, DataType=vm:PerfPoint}" />
                    </arc:LineChart.Series>
                  </arc:LineChart>
                </StackPanel>
              </Border>
              <Border Classes="card" Margin="6,0,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Classes="cardtitle" Text="{loc:T Performance.TimePerPassMs}" />
                  <arc:LineChart Label="{loc:T Performance.LayoutAndRenderTime}" PlotHeight="150" YMinimum="0" Unit="ms" Curve="Linear" ValueFormat="0.##"
                                 ItemsSource="{Binding History}" XBinding="{CompiledBinding T, DataType=vm:PerfPoint}" ShowXAxis="False">
                    <arc:LineChart.Series>
                      <arc:ChartSeries Key="layout" Name="Layout" ValueBinding="{CompiledBinding LayoutMs, DataType=vm:PerfPoint}" />
                      <arc:ChartSeries Key="render" Name="Render" ValueBinding="{CompiledBinding RenderMs, DataType=vm:PerfPoint}" />
                    </arc:LineChart.Series>
                  </arc:LineChart>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- percentiles + overlays -->
            <Grid ColumnDefinitions="*,260">
              <Border Classes="card" Margin="0,0,12,0">
                <StackPanel Spacing="6">
                  <TextBlock Classes="cardtitle" Text="{loc:T Performance.PercentilesRolling10S}" />
                  <Grid ColumnDefinitions="150,*,*,*,*,*,70">
                    <TextBlock Classes="cardmeta" Text="{loc:T Performance.Pass}" />
                    <TextBlock Classes="cardmeta" Grid.Column="1" Text="P50" />
                    <TextBlock Classes="cardmeta" Grid.Column="2" Text="P90" />
                    <TextBlock Classes="cardmeta" Grid.Column="3" Text="P95" />
                    <TextBlock Classes="cardmeta" Grid.Column="4" Text="{loc:T Performance.Avg}" />
                    <TextBlock Classes="cardmeta" Grid.Column="5" Text="{loc:T Performance.Max}" />
                    <TextBlock Classes="cardmeta" Grid.Column="6" Text="{loc:T Performance.Count}" />
                  </Grid>
                  <TextBlock Classes="cardmeta" IsVisible="{Binding NoPercentiles}" Margin="0,6,0,0"
                             Text="{loc:T Performance.NoFramesOrLayout}" />
                  <ItemsControl ItemsSource="{Binding Percentiles}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PercentileRow">
                        <Grid ColumnDefinitions="150,*,*,*,*,*,70">
                          <TextBlock Text="{Binding Name}" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                          <TextBlock Grid.Column="1" Text="{Binding P50}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                          <TextBlock Grid.Column="2" Text="{Binding P90}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                          <TextBlock Grid.Column="3" Text="{Binding P95}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                          <TextBlock Grid.Column="4" Text="{Binding Avg}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                          <TextBlock Grid.Column="5" Text="{Binding Max}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                          <TextBlock Grid.Column="6" Text="{Binding Count}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeSM}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="cardtitle" Text="{loc:T Performance.OverlaysInTheApp}" />
                  <TextBlock Classes="cardmeta" Text="{loc:T Performance.DrawnByAvaloniaInside}" />
                  <ItemsControl ItemsSource="{Binding Overlays}" IsEnabled="{Binding OverlaysSupported}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:OverlayToggle">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                          <arc:Switch Grid.Column="1" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <!-- hot spots -->
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="cardtitle" Text="{loc:T Performance.HotSpotsSinceThe}" />
                <TextBlock Classes="cardmeta" Text="{loc:T Performance.NothingRecordedYetInteract}" IsVisible="{Binding NoHotSpots}" />
                <ItemsControl ItemsSource="{Binding HotSpots}" IsVisible="{Binding HasHotSpots}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HotSpotGroup">
                      <StackPanel Spacing="4" Margin="0,0,12,8">
                        <TextBlock Classes="cardmeta" Text="{Binding Title}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HotSpotRow">
                              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeXS}" ToolTip.Tip="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <TextBlock Grid.Column="2" Text="{Binding Total}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
