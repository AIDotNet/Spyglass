<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="clr-namespace:Spyglass.App.ViewModels"
             xmlns:loc="clr-namespace:Spyglass.App.Localization"
             x:Class="Spyglass.App.Views.ConnectionsView"
             x:DataType="vm:ConnectionsViewModel">
  <!-- Wireframe W1 on glass -->
  <Border Classes="glass">
    <ScrollViewer>
      <StackPanel MaxWidth="680" Margin="24,36" Spacing="16" HorizontalAlignment="Center">
        <StackPanel Spacing="16" IsVisible="{Binding NoSessions}">
          <arc:EmptyState Title="{loc:T Connections.WaitingForAnApp}"
                          Description="{loc:T Connections.AddTheSpyglassAgent}"
                          Icon="{lucide:LucideGeometry Kind=Telescope}" />
          <arc:CodeBlock FileName="Program.cs" Language="cs" Code="{Binding AgentSnippet}" />
        </StackPanel>

        <StackPanel Spacing="10" IsVisible="{Binding HasSessions}">
          <TextBlock Text="{loc:T Connections.ConnectedApps}" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Main.Sessions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SessionViewModel">
                <arc:Card Title="{Binding Title}" Description="{Binding Details}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Text="{Binding ListenText}" HorizontalAlignment="Center"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />

        <!-- LAN: only while Spyglass was started with "Allow connections from other devices" -->
        <StackPanel Spacing="10" IsVisible="{Binding Lan.IsActive}">
          <TextBlock Text="{loc:T Lan.OtherDevices}" FontWeight="SemiBold" Margin="0,12,0,0" />
          <arc:Alert Tone="Warning" IsOpen="True" Title="{loc:T Lan.NotEncrypted}"
                     Content="{loc:T Lan.ConnectionsWarning}" />
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{loc:T Lan.HostToUse}" />
                  <TextBlock Text="{Binding Lan.AddressesText}" TextWrapping="Wrap" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                             FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <arc:Button Variant="Secondary" Content="{loc:T Lan.Copy}" Command="{Binding Lan.CopyHostCommand}" />
                  <arc:Button Variant="Ghost" Content="{loc:T Lan.Refresh}" Command="{Binding Lan.RefreshAddressesCommand}" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{loc:T Lan.PairingCode}" />
                  <TextBlock Text="{Binding Lan.Code}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="{arc:ArcDesignTokenResource TypeXL}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <arc:Button Variant="Secondary" Content="{loc:T Lan.Copy}" Command="{Binding Lan.CopyCodeCommand}" />
                  <arc:Button Variant="Secondary" Content="{loc:T Lan.Regenerate}" Command="{Binding Lan.RegenerateCommand}" />
                </StackPanel>
              </Grid>
              <arc:CodeBlock FileName="{loc:T Lan.OtherDeviceFile}" Language="cs" Code="{Binding Lan.Snippet}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBlock Text="{loc:T Connections.UseWithAiCoding}" FontWeight="SemiBold" Margin="0,12,0,0" />
        <arc:CodeBlock FileName="MCP" Language="bash" Code="{Binding McpSnippet}" />
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
