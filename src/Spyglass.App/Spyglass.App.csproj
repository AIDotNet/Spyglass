<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Spyglass client UI: Avalonia 12.1.4 + TKCode.Arc (design/research/02, design/ux/). -->
  <PropertyGroup>
    <!-- Exe (not WinExe): `spyglass mcp` talks MCP on stdin/stdout, which needs a console subsystem. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest Condition="Exists('app.manifest')">app.manifest</ApplicationManifest>
    <AssemblyName>Spyglass</AssemblyName>
    <!-- dotnet tool: `dotnet tool install -g TKCode.Spyglass`, then `spyglass` (GUI) or `spyglass mcp` (headless MCP). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>spyglass</ToolCommandName>
    <!-- RID-specific tool (.NET 10+): one small package per platform plus the `TKCode.Spyglass` pointer package, so each user downloads only their own native assets. -->
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <DebugType>none</DebugType>
    <PackageId>TKCode.Spyglass</PackageId>
    <Description>Open-source debugging tool for Avalonia apps (like browser DevTools) with a free MCP server for AI coding agents.</Description>
    <PackageTags>avalonia;devtools;debugging;mcp;inspector</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="TKCode.Arc" />
    <PackageReference Include="TKCode.Arc.Blocks" />
    <PackageReference Include="TKCode.Arc.Fonts" />
    <PackageReference Include="TKCode.Arc.Icons.Lucide" />
    <PackageReference Include="TKCode.Arc.Themes.Corners" />
    <ProjectReference Include="..\Spyglass.App.Core\Spyglass.App.Core.csproj" />
    <ProjectReference Include="..\Spyglass.Mcp\Spyglass.Mcp.csproj" />
    <!-- `spyglass run` needs the startup hook next to the executable (hook/). Built for ordering, copied below. -->
    <ProjectReference Include="..\Spyglass.StartupHook\Spyglass.StartupHook.csproj" ReferenceOutputAssembly="false" UndefineProperties="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <!-- hook/ next to the executable, in the build output and in the published tool package. -->
  <PropertyGroup>
    <_HookDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Spyglass.StartupHook/bin/$(Configuration)/net8.0/'))</_HookDir>
  </PropertyGroup>
  <Target Name="CopyStartupHook" AfterTargets="Build">
    <ItemGroup>
      <_HookFile Include="$(_HookDir)**/*" Exclude="$(_HookDir)**/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_HookFile)" DestinationFiles="@(_HookFile->'$(OutDir)hook/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishStartupHook" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_HookFile Include="$(_HookDir)**/*" Exclude="$(_HookDir)**/*.pdb" />
      <ResolvedFileToPublish Include="@(_HookFile)" RelativePath="hook/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
