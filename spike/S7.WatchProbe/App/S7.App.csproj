<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike S7: run under `dotnet watch` (R1, R2, R13). Headless Avalonia app that prints its state every second. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The apphost is SIGKILLed on this machine (exit 137); run through the dotnet host instead. -->
    <UseAppHost>false</UseAppHost>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaNameGeneratorBehavior>OnlyProperties</AvaloniaNameGeneratorBehavior>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="SpyglassHotReloadStamps" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.4" />
    <ProjectReference Include="..\Generator\S7.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
