<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike S8 (R5): what do compiled StyleInclude/ResourceInclude/MergeResourceInclude become at run time, and can a
       classless Styles/ResourceDictionary document or App.axaml be hot-reloaded? Headless. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.4" />
  </ItemGroup>
</Project>
