<Project Sdk="Microsoft.NET.Sdk">
  <!-- End-to-end: a headless Avalonia app with Spyglass.Agent connects to an in-process SpyglassHub. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Tests use explicit timeouts; threading TestContext tokens through every call adds noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <ProjectReference Include="..\..\src\Spyglass.Agent\Spyglass.Agent.csproj" />
    <ProjectReference Include="..\..\src\Spyglass.Agent.Advanced\Spyglass.Agent.Advanced.csproj" />
    <!-- Hot reload: what the Spyglass.HotReload package gives an app (runtime + generator + targets). -->
    <ProjectReference Include="..\..\src\Spyglass.Agent.HotReload\Spyglass.Agent.HotReload.csproj" />
    <ProjectReference Include="..\..\src\Spyglass.HotReload.Generators\Spyglass.HotReload.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Spyglass.App.Core\Spyglass.App.Core.csproj" />
    <ProjectReference Include="..\..\src\Spyglass.Mcp\Spyglass.Mcp.csproj" />
    <!-- Built (not referenced) so McpCliTests can launch the real `spyglass mcp` process. -->
    <ProjectReference Include="..\..\src\Spyglass.App\Spyglass.App.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>
  <Import Project="..\..\src\Spyglass.Agent.HotReload\buildTransitive\TKCode.Spyglass.HotReload.targets" />
</Project>
