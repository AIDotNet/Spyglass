<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Spyglass.IntegrationTests"
        x:Class="Spyglass.IntegrationTests.TestWindow"
        x:DataType="local:TestViewModel"
        Width="600" Height="400" Title="Main">
  <StackPanel x:Name="Root" Margin="16" Spacing="8">
    <TextBlock x:Name="Heading" Text="{Binding Title}" />
    <TextBlock x:Name="Broken" x:CompileBindings="False" Text="{Binding User.FullNmae}" />
    <TextBox x:Name="NameBox" PlaceholderText="Your name" />
    <StackPanel x:Name="Buttons" Orientation="Horizontal" Spacing="8">
      <Button x:Name="SaveButton" Classes="primary" Content="Save" Width="120" Height="32" Margin="4,2" />
      <Button x:Name="CancelButton" Content="Cancel" IsEnabled="False" />
    </StackPanel>
    <Border x:Name="Card" Classes="card highlight" Height="20" />
    <!-- layout_explain scenarios -->
    <StackPanel x:Name="HiddenPanel" IsVisible="False">
      <Button x:Name="InHidden" Content="In hidden panel" />
    </StackPanel>
    <Button x:Name="Ghost" Content="Ghost" Opacity="0" />
    <Border x:Name="Collapsed" Width="0" Height="10"><Button x:Name="InCollapsed" Content="x" /></Border>
    <Border x:Name="ClipBox" Width="60" Height="20" ClipToBounds="True">
      <Canvas><Button x:Name="Outside" Content="Out" Canvas.Left="200" Canvas.Top="0" /></Canvas>
    </Border>
    <ScrollViewer x:Name="Scroller" Height="40">
      <StackPanel>
        <TextBlock Text="first" Height="30" />
        <TextBlock Text="second" Height="30" />
        <Button x:Name="BelowFold" Content="below the fold" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel.Resources>
      <x:Double x:Key="Test.Gap">4</x:Double>
    </StackPanel.Resources>
    <Border x:Name="Swatch" Classes="swatch" Height="10" Width="{DynamicResource Test.Gap}" Background="{DynamicResource Test.Brush}" />
  </StackPanel>
  <Window.Resources>
    <SolidColorBrush x:Key="Test.Brush" Color="#00AA00" />
  </Window.Resources>
</Window>
