<Project Sdk="Microsoft.NET.Sdk">
  <!-- Attach without code changes: launches a Spyglass-free Avalonia app with DOTNET_STARTUP_HOOKS pointing at the hook. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="..\..\src\Spyglass.App.Core\Spyglass.App.Core.csproj" />
    <!-- Built, not referenced: the test starts them as separate processes. -->
    <ProjectReference Include="..\..\src\Spyglass.StartupHook\Spyglass.StartupHook.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Spyglass.StartupHook.TestApp\Spyglass.StartupHook.TestApp.csproj" ReferenceOutputAssembly="false" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HookDll</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\src\Spyglass.StartupHook\bin\$(Configuration)\net8.0\Spyglass.StartupHook.dll'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TestAppDll</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Spyglass.StartupHook.TestApp\bin\$(Configuration)\net10.0\Spyglass.StartupHook.TestApp.dll'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
