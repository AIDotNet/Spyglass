<Project Sdk="Microsoft.NET.Sdk">
  <!-- Smoke test of the Avalonia 11 build of the agent: a headless Avalonia 11.2.2 app (code-only UI) connects to the real hub. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia" VersionOverride="11.2.2" />
    <PackageReference Include="Avalonia.Headless" VersionOverride="11.2.2" />
    <PackageReference Include="Avalonia.Skia" VersionOverride="11.2.2" />
    <PackageReference Include="Avalonia.Themes.Simple" VersionOverride="11.2.2" />
    <ProjectReference Include="..\..\src\Spyglass.Agent.Avalonia11\Spyglass.Agent.Avalonia11.csproj" />
    <ProjectReference Include="..\..\src\Spyglass.App.Core\Spyglass.App.Core.csproj" />
  </ItemGroup>
</Project>
