<Project Sdk="Microsoft.NET.Sdk">
  <!-- A console app that merely ships Avalonia 11.0.13 (below the supported 11.2): the hook must decline politely. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" VersionOverride="11.0.13" />
  </ItemGroup>
</Project>
